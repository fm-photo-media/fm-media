# Copy to .env.local for local development. Never commit real values (.env* is git-ignored).
# Every value below is a public placeholder: production refuses them (SEC-6, SEC-20).

DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Admin sign-in. Production requires ADMIN_PASSWORD with 16+ characters and
# ADMIN_SESSION_SECRET with 32+ random characters (different from the password).
# Rotating ADMIN_SESSION_SECRET signs every admin device out.
ADMIN_PASSWORD="replace-with-16-plus-characters"
ADMIN_SESSION_SECRET="replace-with-32-plus-random-characters"

# Salt for the rate limiter's hashed client IDs. REQUIRED in production (32+ random
# characters, its own value, not the session secret). Without it, admin sign-in is
# refused and booking limits are skipped (both logged).
RATE_LIMIT_SALT="replace-with-32-plus-random-characters"

# How many months booking inquiries are kept before the admin's "Delete old inquiries"
# button offers to remove them (whole months, 1 to 120). Optional; default 24.
INQUIRY_RETENTION_MONTHS="24"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
EMAIL_FROM="FM Media <bookings@yourdomain.com>"
EMAIL_TO="owner@yourdomain.com"
EMAIL_API_KEY="resend_api_key_here"
BLOB_READ_WRITE_TOKEN="vercel_blob_token_here"
